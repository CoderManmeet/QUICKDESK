# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickdesk?schema=public"

# Public base URL of the app (used in password reset links)
APP_URL="http://localhost:3000"

# Brevo transactional email. Leave BREVO_API_KEY empty in development:
# emails are then printed to the server console instead of being sent.
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="support@example.com"
EMAIL_FROM_NAME="QuickDesk"

# Password given to every seeded account
SEED_PASSWORD="QuickDesk@123"

# Attachment storage. "local" keeps files on disk in STORAGE_LOCAL_DIR (development).
# Use "s3" in production with any S3-compatible service (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Protects the scheduled job at /api/cron/run (SLA warnings, escalation,
# auto-close, time-based automation). Use a long random string.
CRON_SECRET=""
