# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickdesk?schema=public"

# Public base URL of the app (used in password reset links)
APP_URL="http://localhost:3000"

# Brevo transactional email. Leave BREVO_API_KEY empty in development:
# emails are then printed to the server console instead of being sent.
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="support@example.com"
EMAIL_FROM_NAME="QuickDesk"

# Password given to every seeded account
SEED_PASSWORD="QuickDesk@123"
